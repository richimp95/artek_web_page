---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLang, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  routeKey?: RouteKey;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, routeKey = 'home', jsonLd } = Astro.props;
const lang = (Astro.currentLocale ?? defaultLang) as Lang;
---

<BaseLayout title={title} description={description} routeKey={routeKey} jsonLd={jsonLd}>
  <Header lang={lang} routeKey={routeKey} />
  <main>
    <slot />
  </main>
  <Footer lang={lang} />
</BaseLayout>

---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import { defaultLang, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  /** Sección actual, para canonical/hreflang y estado activo del nav. */
  routeKey?: RouteKey;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, routeKey = 'home', jsonLd } = Astro.props;
const lang = (Astro.currentLocale ?? defaultLang) as Lang;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO title={title} description={description} lang={lang} routeKey={routeKey} jsonLd={jsonLd} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <slot />
  </body>
</html>

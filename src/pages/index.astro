---
import PageLayout from '../layouts/PageLayout.astro';
import HomeSections from '../components/HomeSections.astro';
import { webSite } from '../data/schema';
import { pageSeo } from '../data/seo';

const lang = 'es' as const;
const seo = pageSeo.home[lang];
---

<PageLayout title={seo.title} description={seo.description} routeKey="home" jsonLd={webSite(lang)}>
  <HomeSections />
</PageLayout>

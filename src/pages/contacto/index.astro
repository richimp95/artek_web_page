---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactSection from '../../components/ContactSection.astro';
import { useTranslations } from '../../i18n/ui';
import { breadcrumbs, productionUrl } from '../../data/schema';
import { pageSeo } from '../../data/seo';

const lang = 'es' as const;
const t = useTranslations(lang);
const seo = pageSeo.contact[lang];
const jsonLd = breadcrumbs([
  { name: t('breadcrumb.home'), url: productionUrl(lang, 'home') },
  { name: t('nav.contact'), url: productionUrl(lang, 'contact') },
]);
---

<PageLayout title={seo.title} description={seo.description} routeKey="contact" jsonLd={jsonLd}>
  <ContactSection />
</PageLayout>

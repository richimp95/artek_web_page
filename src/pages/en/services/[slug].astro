---
import type { GetStaticPaths } from 'astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import ServiceDetail from '../../../components/ServiceDetail.astro';
import { services, type Service } from '../../../data/services';
import { useTranslations, getRoutePath } from '../../../i18n/ui';
import { breadcrumbs, productionUrl, serviceSchema } from '../../../data/schema';
import { serviceSeo } from '../../../data/seo';

export const getStaticPaths = (() => {
  return services.map((service) => ({
    params: { slug: service.slug.en },
    props: { service },
  }));
}) satisfies GetStaticPaths;

const { service } = Astro.props as { service: Service };
const lang = 'en' as const;
const t = useTranslations(lang);

const esPath = `${getRoutePath('es', 'services')}${service.slug.es}/`;
const enPath = `${getRoutePath('en', 'services')}${service.slug.en}/`;

const seo = serviceSeo[service.id][lang];

const jsonLd = [
  serviceSchema(service, lang),
  breadcrumbs([
    { name: t('breadcrumb.home'), url: productionUrl(lang, 'home') },
    { name: t('nav.services'), url: productionUrl(lang, 'services') },
    { name: service.title[lang], url: productionUrl(lang, 'services', service.slug[lang]) },
  ]),
];
---

<PageLayout
  title={seo.title}
  description={seo.description}
  routeKey="services"
  path={enPath}
  alternates={{ es: esPath, en: enPath }}
  jsonLd={jsonLd}
>
  <ServiceDetail service={service} lang={lang} />
</PageLayout>

---
type IconName = 'instagram' | 'facebook' | 'whatsapp' | 'mail' | 'phone';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 22, class: extra = '' } = Astro.props;
const stroke = name !== 'whatsapp' && name !== 'facebook';
---

<svg
  class:list={['icon', extra]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={stroke ? 'none' : 'currentColor'}
  stroke={stroke ? 'currentColor' : 'none'}
  stroke-width={stroke ? 1.6 : undefined}
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-hidden="true"
>
  {
    name === 'instagram' && (
      <>
        <rect x="2" y="2" width="20" height="20" rx="5.5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none" />
      </>
    )
  }
  {name === 'facebook' && <path d="M14 9V7.5c0-.7.3-1 1-1h1.5V3.2C16 3.1 14.9 3 13.8 3 11.4 3 10 4.4 10 7v2H7.5v3.4H10V21h3.5v-8.6H16l.5-3.4H13.5" />}
  {
    name === 'whatsapp' && (
      <path d="M19.05 4.91A10 10 0 0 0 2.06 12c0 1.76.46 3.48 1.34 5L2 22l5.13-1.35A10 10 0 0 0 22 12a9.94 9.94 0 0 0-2.95-7.09zM12 20.1a8.3 8.3 0 0 1-4.22-1.16l-.3-.18-3.04.8.81-2.97-.2-.31A8.3 8.3 0 1 1 12 20.1zm4.55-6.2c-.25-.13-1.47-.72-1.7-.8-.23-.09-.4-.13-.56.12-.17.25-.64.8-.79.97-.14.16-.29.18-.54.06a6.8 6.8 0 0 1-2-1.24 7.53 7.53 0 0 1-1.39-1.72c-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.84-.2-.48-.4-.42-.56-.42l-.47-.01a.92.92 0 0 0-.66.3 2.77 2.77 0 0 0-.86 2.06c0 1.21.88 2.39 1 2.55.13.17 1.74 2.66 4.22 3.73.59.26 1.05.41 1.4.52.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.2-.58.2-1.07.14-1.18-.06-.1-.23-.16-.48-.29z" />
    )
  }
  {
    name === 'mail' && (
      <>
        <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
        <path d="m3 6 9 7 9-7" />
      </>
    )
  }
  {
    name === 'phone' && (
      <path d="M6.6 3.5 8.9 4a1 1 0 0 1 .77.84l.34 2.3a1 1 0 0 1-.55 1.04l-1.3.65a12 12 0 0 0 5 5l.65-1.3a1 1 0 0 1 1.04-.55l2.3.34a1 1 0 0 1 .84.77l.5 2.3a1 1 0 0 1-.86 1.21A15.5 15.5 0 0 1 4.2 5.36 1 1 0 0 1 5.4 4.5z" />
    )
  }
</svg>

<style>
  .icon {
    display: block;
    flex-shrink: 0;
  }
</style>

---
interface Props {
  /** Número de sección, p.ej. "01" */
  number?: string;
  eyebrow?: string;
  title?: string;
  /** Fondo alternativo (superficie sutil) */
  alt?: boolean;
  id?: string;
  class?: string;
}

const { number, eyebrow, title, alt = false, id, class: extra = '' } = Astro.props;
const hasHeader = Boolean(number || eyebrow || title);
---

<section class:list={['section', { 'section--alt': alt }, extra]} id={id}>
  <div class="container">
    {
      hasHeader && (
        <header class="section__head">
          {number && <span class="section__number">{number}</span>}
          <div class="section__heading">
            {eyebrow && <p class="eyebrow">{eyebrow}</p>}
            {title && <h2 class="section__title">{title}</h2>}
          </div>
        </header>
      )
    }
    <div class="section__body">
      <slot />
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-2xl);
  }
  .section--alt {
    background: var(--bg-alt);
  }

  .section__head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-m);
    align-items: start;
    padding-bottom: var(--space-l);
    margin-bottom: var(--space-l);
    border-bottom: 1px solid var(--rule);
  }

  .section__number {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-feature-settings: 'tnum';
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .section__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .section__title {
    margin-top: var(--space-2xs);
  }

  @media (max-width: 40rem) {
    .section__head {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }
  }
</style>

---
interface Props {
  eyebrow?: string;
  title?: string;
  /** Fondo alternativo (superficie sutil) */
  alt?: boolean;
  /** Oculta la marca de gradiente sobre el título */
  noMark?: boolean;
  headingTag?: 'h1' | 'h2';
  id?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  alt = false,
  noMark = false,
  headingTag = 'h2',
  id,
  class: extra = '',
} = Astro.props;
const hasHeader = Boolean(eyebrow || title);
const HeadingTag = headingTag;
---

<section class:list={['section', { 'section--alt': alt }, extra]} id={id}>
  <div class="container">
    {
      hasHeader && (
        <header class="section__head" data-reveal>
          {!noMark && <span class="section__mark" aria-hidden="true" />}
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {title && <HeadingTag class="section__title">{title}</HeadingTag>}
        </header>
      )
    }
    <div class="section__body">
      <slot />
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-2xl);
  }
  .section--alt {
    background: var(--bg-alt);
  }

  .section__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    max-width: var(--container-narrow);
    margin-bottom: var(--space-xl);
  }

  /* Marca de marca: un trazo corto de gradiente. Firma, no andamiaje. */
  .section__mark {
    width: 3rem;
    height: 3px;
    border-radius: 2px;
    background: var(--gradient-brand);
    margin-bottom: var(--space-xs);
  }

  .section__title {
    text-wrap: balance;
  }
</style>

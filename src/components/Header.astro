---
import { Image } from 'astro:assets';
import LangSwitcher from './LangSwitcher.astro';
import logo from '../assets/logo-artek-white.png';
import {
  getRoutePath,
  navItems,
  useTranslations,
  defaultLang,
  type Lang,
  type RouteKey,
} from '../i18n/ui';

interface Props {
  lang: Lang;
  routeKey: RouteKey;
}

const { lang, routeKey } = Astro.props;
const t = useTranslations(lang);
const homeHref = getRoutePath(lang, 'home');
const items = navItems.map((item) => ({
  ...item,
  href: getRoutePath(lang, item.key),
  active: item.key === routeKey,
}));
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={homeHref} aria-label="Artek — Inicio">
      <Image src={logo} alt="Artek" widths={[150, 300]} sizes="150px" loading="eager" class="site-header__logo" />
    </a>

    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="visually-hidden">Menú</span>
      <span class="site-header__bars" aria-hidden="true"></span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Principal" data-nav>
      <ul class="site-nav__list">
        {
          items.map((item) => (
            <li>
              <a
                class:list={['site-nav__link', { 'is-active': item.active }]}
                href={item.href}
                aria-current={item.active ? 'page' : undefined}
              >
                {t(item.label)}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="site-nav__lang">
        <LangSwitcher lang={lang} routeKey={routeKey} />
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out);
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--rule);
  }

  /*
   * El blur frosted del header SOLO en desktop. En móvil un ancestro con
   * backdrop-filter se vuelve el contenedor de los position:fixed hijos,
   * lo que rompía la posición del menú (salía cortado y transparente).
   */
  @media (min-width: 52.0625rem) {
    .site-header.is-scrolled {
      background: color-mix(in srgb, var(--bg) 72%, transparent);
      backdrop-filter: blur(12px) saturate(1.2);
      -webkit-backdrop-filter: blur(12px) saturate(1.2);
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block: var(--space-s);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
  }
  .site-header__logo {
    height: clamp(1.75rem, 1.4rem + 1vw, 2.25rem);
    width: auto;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-l);
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    list-style: none;
    padding: 0;
  }

  .site-nav__link {
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-muted);
    padding-block: 0.35em;
    border-bottom: 1px solid transparent;
    transition:
      color var(--transition),
      border-color var(--transition);
  }
  .site-nav__link:hover,
  .site-nav__link.is-active {
    color: var(--fg);
    border-color: var(--accent);
  }

  .site-header__toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .site-header__bars,
  .site-header__bars::before,
  .site-header__bars::after {
    display: block;
    width: 18px;
    height: 1px;
    background: var(--fg);
    transition: transform var(--transition), opacity var(--transition);
  }
  .site-header__bars {
    position: relative;
  }
  .site-header__bars::before,
  .site-header__bars::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .site-header__bars::before {
    top: -6px;
  }
  .site-header__bars::after {
    top: 6px;
  }

  /* --- Móvil --- */
  @media (max-width: 52rem) {
    .site-header__toggle {
      display: inline-flex;
    }

    /*
     * El overlay arranca en --hdr-h (alto real del header, puesto por JS).
     * Así nunca tapa la barra superior y no hay conflicto de stacking context.
     * El blur de backdrop-filter difumina el contenido de la página detrás.
     */
    .site-nav {
      position: fixed;
      top: var(--hdr-h, 4.5rem); /* debajo del header bar */
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 200;

      /* Frosted glass oscuro */
      background: color-mix(in srgb, var(--color-void) 88%, transparent);
      backdrop-filter: blur(22px) saturate(1.1);
      -webkit-backdrop-filter: blur(22px) saturate(1.1);

      /* Layout: alineado arriba y desplazable para que el selector de idioma
         nunca choque ni se corte en pantallas cortas. */
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      gap: var(--space-l);
      padding-block: var(--space-xl) var(--space-l);
      overflow-y: auto;
      overscroll-behavior: contain;

      /* Línea de marca en el borde superior */
      border-top: 2px solid transparent;
      border-image: var(--gradient-brand) 1;

      /* Animación: fade + ligero desliz hacia abajo */
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-10px);
      transition:
        opacity 260ms ease,
        visibility 260ms ease,
        transform 260ms ease;
    }

    .site-nav.is-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    .site-nav__list {
      flex-direction: column;
      align-items: center;
      gap: var(--space-l);
    }

    .site-nav__link {
      font-size: var(--step-2);
      letter-spacing: 0.08em;
    }

    .site-nav__lang {
      margin-top: var(--space-s);
    }

    /* Hamburguesa → X */
    .site-header[data-open] .site-header__bars {
      background: transparent;
    }
    .site-header[data-open] .site-header__bars::before {
      transform: translateY(6px) rotate(45deg);
    }
    .site-header[data-open] .site-header__bars::after {
      transform: translateY(-6px) rotate(-45deg);
    }
  }
</style>

<script>
  // Re-vinculamos en cada navegación (View Transitions reemplaza el DOM).
  // Los listeners globales (window/document) se registran una sola vez.
  let globalsBound = false;

  function initHeader() {
    const root = document.querySelector<HTMLElement>('.site-header');
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    if (!root || !toggle || !nav) return;

    const setHeaderHeight = () => {
      const h = root.getBoundingClientRect().height ?? 0;
      document.documentElement.style.setProperty('--hdr-h', `${h}px`);
    };
    setHeaderHeight();

    const closeMenu = () => {
      nav.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      root.removeAttribute('data-open');
      document.body.style.overflow = '';
    };

    toggle.addEventListener('click', () => {
      const opening = !nav.classList.contains('is-open');
      if (opening) {
        setHeaderHeight();
        nav.classList.add('is-open');
        toggle.setAttribute('aria-expanded', 'true');
        root.setAttribute('data-open', '');
        document.body.style.overflow = 'hidden';
      } else {
        closeMenu();
      }
    });

    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));

    // Sombra/condensado del header al hacer scroll.
    const onScroll = () => root.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();

    if (!globalsBound) {
      globalsBound = true;
      window.addEventListener('resize', () => {
        document.querySelector<HTMLElement>('.site-header') && setHeaderHeight();
        if (window.innerWidth > 832) {
          document.querySelector<HTMLElement>('[data-nav]')?.classList.remove('is-open');
        }
      }, { passive: true });
      window.addEventListener('scroll', () => {
        const h = document.querySelector<HTMLElement>('.site-header');
        h?.classList.toggle('is-scrolled', window.scrollY > 8);
      }, { passive: true });
      document.addEventListener('keydown', (e) => {
        const n = document.querySelector<HTMLElement>('[data-nav]');
        if (e.key === 'Escape' && n?.classList.contains('is-open')) {
          n.classList.remove('is-open');
          document.querySelector<HTMLButtonElement>('[data-nav-toggle]')?.setAttribute('aria-expanded', 'false');
          document.querySelector<HTMLElement>('.site-header')?.removeAttribute('data-open');
          document.body.style.overflow = '';
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initHeader);
</script>

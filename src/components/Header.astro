---
import { Image } from 'astro:assets';
import LangSwitcher from './LangSwitcher.astro';
import logo from '../assets/logo-artek.png';
import {
  getRoutePath,
  navItems,
  useTranslations,
  defaultLang,
  type Lang,
  type RouteKey,
} from '../i18n/ui';

interface Props {
  lang: Lang;
  routeKey: RouteKey;
}

const { lang, routeKey } = Astro.props;
const t = useTranslations(lang);
const homeHref = getRoutePath(lang, 'home');
const items = navItems.map((item) => ({
  ...item,
  href: getRoutePath(lang, item.key),
  active: item.key === routeKey,
}));
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={homeHref} aria-label="Artek — Inicio">
      <Image src={logo} alt="Artek" widths={[150, 300]} sizes="150px" loading="eager" class="site-header__logo" />
    </a>

    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="visually-hidden">Menú</span>
      <span class="site-header__bars" aria-hidden="true"></span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Principal" data-nav>
      <ul class="site-nav__list">
        {
          items.map((item) => (
            <li>
              <a
                class:list={['site-nav__link', { 'is-active': item.active }]}
                href={item.href}
                aria-current={item.active ? 'page' : undefined}
              >
                {t(item.label)}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="site-nav__lang">
        <LangSwitcher lang={lang} routeKey={routeKey} />
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block: var(--space-s);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
  }
  .site-header__logo {
    height: clamp(1.75rem, 1.4rem + 1vw, 2.25rem);
    width: auto;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-l);
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    list-style: none;
    padding: 0;
  }

  .site-nav__link {
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-muted);
    padding-block: 0.35em;
    border-bottom: 1px solid transparent;
    transition:
      color var(--transition),
      border-color var(--transition);
  }
  .site-nav__link:hover,
  .site-nav__link.is-active {
    color: var(--fg);
    border-color: var(--accent);
  }

  .site-header__toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .site-header__bars,
  .site-header__bars::before,
  .site-header__bars::after {
    display: block;
    width: 18px;
    height: 1px;
    background: var(--fg);
    transition: transform var(--transition), opacity var(--transition);
  }
  .site-header__bars {
    position: relative;
  }
  .site-header__bars::before,
  .site-header__bars::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .site-header__bars::before {
    top: -6px;
  }
  .site-header__bars::after {
    top: 6px;
  }

  /* --- Móvil --- */
  @media (max-width: 52rem) {
    .site-header__toggle {
      display: inline-flex;
    }

    /*
     * El overlay arranca en --hdr-h (alto real del header, puesto por JS).
     * Así nunca tapa la barra superior y no hay conflicto de stacking context.
     * El blur de backdrop-filter difumina el contenido de la página detrás.
     */
    .site-nav {
      position: fixed;
      top: var(--hdr-h, 4.5rem); /* debajo del header bar */
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 200;

      /* Frosted glass */
      background: rgba(251, 250, 248, 0.92);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);

      /* Layout */
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--space-xl);

      /* Línea de marca en el borde superior */
      border-top: 2px solid transparent;
      border-image: var(--gradient-brand) 1;

      /* Animación: fade + ligero desliz hacia abajo */
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-10px);
      transition:
        opacity 260ms ease,
        visibility 260ms ease,
        transform 260ms ease;
    }

    .site-nav.is-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    .site-nav__list {
      flex-direction: column;
      align-items: center;
      gap: var(--space-l);
    }

    .site-nav__link {
      font-size: var(--step-2);
      letter-spacing: 0.08em;
    }

    .site-nav__lang {
      margin-top: var(--space-s);
    }

    /* Hamburguesa → X */
    .site-header[data-open] .site-header__bars {
      background: transparent;
    }
    .site-header[data-open] .site-header__bars::before {
      transform: translateY(6px) rotate(45deg);
    }
    .site-header[data-open] .site-header__bars::after {
      transform: translateY(-6px) rotate(-45deg);
    }
  }
</style>

<script>
  const root   = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav    = document.querySelector<HTMLElement>('[data-nav]');

  // Mide el header y actualiza --hdr-h para que el overlay arranque justo debajo.
  function setHeaderHeight() {
    const h = root?.getBoundingClientRect().height ?? 0;
    document.documentElement.style.setProperty('--hdr-h', `${h}px`);
  }
  setHeaderHeight();
  window.addEventListener('resize', setHeaderHeight, { passive: true });

  function closeMenu() {
    nav?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    root?.removeAttribute('data-open');
    document.body.style.overflow = '';
  }

  toggle?.addEventListener('click', () => {
    const opening = !nav?.classList.contains('is-open');
    if (opening) {
      setHeaderHeight(); // recalcular por si cambió con el scroll
      nav?.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      root?.setAttribute('data-open', '');
      document.body.style.overflow = 'hidden';
    } else {
      closeMenu();
    }
  });

  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));

  window.addEventListener('resize', () => {
    if (window.innerWidth > 832) closeMenu();
  }, { passive: true });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('is-open')) closeMenu();
  });
</script>

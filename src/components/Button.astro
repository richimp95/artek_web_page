---
interface Props {
  href?: string;
  variant?: 'solid' | 'outline' | 'ghost';
  external?: boolean;
  class?: string;
}

const { href, variant = 'outline', external = false, class: extra = '' } = Astro.props;
const Tag = href ? 'a' : 'button';
const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---

<Tag class:list={['btn', `btn--${variant}`, extra]} href={href} rel={rel} target={target}>
  <span class="btn__label"><slot /></span>
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.85em 1.6em;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    cursor: pointer;
    background: none;
    /* Solo propiedades baratas en GPU (transform/opacity/filtros) + color. */
    transition:
      background var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  /* Feedback de pulsación (Emil): el botón "escucha" al usuario. */
  .btn:active {
    transform: scale(0.97);
  }

  .btn--solid {
    background: var(--gradient-brand);
    color: var(--fg-on-accent); /* texto oscuro: AA en todo el gradiente */
    border-color: transparent;
  }
  .btn--solid:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px -10px color-mix(in srgb, var(--brand) 80%, transparent);
  }
  .btn--solid:active {
    transform: scale(0.97) translateY(-1px);
  }

  .btn--outline {
    color: var(--fg);
    border-color: var(--color-line-strong);
  }
  .btn--outline:hover {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .btn--ghost {
    color: var(--fg);
    padding-inline: 0;
    border: none;
  }
  .btn--ghost .btn__label {
    border-bottom: 2px solid transparent;
    background-image: var(--gradient-brand);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 2px;
    padding-bottom: 0.3em;
    transition: background-size var(--transition);
  }
  .btn--ghost:hover .btn__label {
    color: var(--accent-strong);
  }
</style>

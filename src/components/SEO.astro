---
import {
  defaultLang,
  getAbsoluteUrl,
  type Lang,
  type RouteKey,
} from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  routeKey: RouteKey;
  /** JSON-LD opcional (objeto schema.org) inyectado en <head>. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, lang, routeKey, jsonLd } = Astro.props;

const site = Astro.site ?? new URL('http://localhost');
const base = import.meta.env.BASE_URL;
const join = (...p: string[]) => `/${p.filter(Boolean).join('/')}/`.replace(/\/{2,}/g, '/');

const canonical = getAbsoluteUrl(site, lang, routeKey);
const alternates: { lang: Lang; href: string }[] = [
  { lang: 'es', href: getAbsoluteUrl(site, 'es', routeKey) },
  { lang: 'en', href: getAbsoluteUrl(site, 'en', routeKey) },
];
const xDefault = getAbsoluteUrl(site, defaultLang, routeKey);
const ogLocale = lang === 'es' ? 'es_GT' : 'en_US';
const ogImage = new URL(join(base, 'og-image.jpg'), site).href;
const faviconHref = join(base, 'favicon.svg');
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
<link rel="alternate" hreflang="x-default" href={xDefault} />

<!-- Open Graph / Twitter -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Artek" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />

<link rel="icon" href={faviconHref} type="image/svg+xml" />

{
  jsonLd && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  )
}

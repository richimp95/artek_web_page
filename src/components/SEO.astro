---
import {
  defaultLang,
  getAbsoluteUrl,
  type Lang,
  type RouteKey,
} from '../i18n/ui';
import { localBusiness } from '../data/schema';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  routeKey: RouteKey;
  /** Ruta base-relativa de ESTA página (para detalle con slug propio). */
  path?: string;
  /** Rutas base-relativas por idioma (hreflang) cuando los slugs difieren. */
  alternates?: Record<Lang, string>;
  /** JSON-LD opcional (objeto schema.org) inyectado en <head>. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, lang, routeKey, path, alternates, jsonLd } = Astro.props;

const site = Astro.site ?? new URL('http://localhost');
const isPages = (process.env.DEPLOY_TARGET ?? 'ftp') === 'pages';
const base = import.meta.env.BASE_URL;
const join = (...p: string[]) => `/${p.filter(Boolean).join('/')}/`.replace(/\/{2,}/g, '/');
// Para archivos estáticos: SIN barra final (si no, el navegador pide "favicon.png/" → 404).
const joinFile = (...p: string[]) => `/${p.filter(Boolean).join('/')}`.replace(/\/{2,}/g, '/');
const langs: Lang[] = ['es', 'en'];

const canonical = path ? new URL(path, site).href : getAbsoluteUrl(site, lang, routeKey);
const altList = langs.map((l) => ({
  lang: l,
  href: alternates ? new URL(alternates[l], site).href : getAbsoluteUrl(site, l, routeKey),
}));
const xDefault = alternates
  ? new URL(alternates[defaultLang], site).href
  : getAbsoluteUrl(site, defaultLang, routeKey);

const ogLocale = lang === 'es' ? 'es_GT' : 'en_US';
const ogLocaleAlternate = lang === 'es' ? 'en_US' : 'es_GT';
const assetVersion = '2';
const versioned = (filePath: string) => `${filePath}?v=${assetVersion}`;
const ogImage = new URL(versioned(joinFile(base, 'og-image.jpg')), site).href;
const favicon32 = versioned(joinFile(base, 'favicon-32.png'));
const favicon16 = versioned(joinFile(base, 'favicon-16.png'));
const appleTouch = versioned(joinFile(base, 'apple-touch-icon.png'));
const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const jsonLdGraph = [localBusiness(lang), ...pageJsonLd];
---

<title>{title}</title>
<meta name="description" content={description} />
{isPages && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical} />
{altList.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
<link rel="alternate" hreflang="x-default" href={xDefault} />

<!-- Open Graph / Twitter -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Artek" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={ogLocaleAlternate} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />

<link rel="icon" href={favicon32} type="image/png" sizes="32x32" />
<link rel="icon" href={favicon16} type="image/png" sizes="16x16" />
<link rel="apple-touch-icon" href={appleTouch} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />

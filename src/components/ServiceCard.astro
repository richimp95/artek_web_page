---
import { getRoutePath, useTranslations, type Lang } from '../i18n/ui';
import type { Service } from '../data/services';

interface Props {
  service: Service;
  lang: Lang;
  index: number;
}

const { service, lang } = Astro.props;
const t = useTranslations(lang);
const href = `${getRoutePath(lang, 'services')}${service.slug[lang]}/`;
---

<a class="service-card" href={href} data-reveal>
  <h3 class="service-card__title">{service.title[lang]}</h3>
  <p class="service-card__summary">{service.summary[lang]}</p>
  <span class="service-card__more">{t('services.more')} <span class="service-card__arrow" aria-hidden="true">&rarr;</span></span>
</a>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-m) 0;
    border-top: 1px solid var(--rule);
    transition:
      border-color var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .service-card:hover {
      border-top-color: var(--accent-strong);
      transform: translateX(6px);
    }
  }

  .service-card__title {
    font-size: var(--step-2);
    transition: color var(--dur) var(--ease-out);
  }
  .service-card:hover .service-card__title {
    color: var(--accent-strong);
  }

  .service-card__summary {
    color: var(--fg-muted);
    font-size: var(--step-0);
    max-width: 42ch;
  }

  .service-card__more {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--fg);
    transition: color var(--dur) var(--ease-out);
  }
  .service-card__arrow {
    display: inline-block;
    transition: transform var(--dur) var(--ease-out);
  }
  .service-card:hover .service-card__more {
    color: var(--accent-strong);
  }
  .service-card:hover .service-card__arrow {
    transform: translateX(5px);
  }
</style>

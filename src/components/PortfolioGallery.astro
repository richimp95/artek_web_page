---
import { Image, getImage } from 'astro:assets';
import { portfolio } from '../data/portfolio';
import { services } from '../data/services';
import { useTranslations, defaultLang, type Lang } from '../i18n/ui';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

const shortLabels: Record<string, Record<Lang, string>> = {
  chromaluxe: { es: 'ChromaLuxe', en: 'ChromaLuxe' },
  acrilico: { es: 'Acrílico', en: 'Acrylic' },
  'fine-art-paper': { es: 'Fine art', en: 'Fine art' },
  'encapsulado-acrilico': { es: 'Encapsulado', en: 'Encapsulation' },
  'gran-formato': { es: 'Gran formato', en: 'Large format' },
  'arte-mural': { es: 'Arte mural', en: 'Wall art' },
};

const usedCats = new Set(portfolio.map((p) => p.category));
const categories = services
  .filter((s) => usedCats.has(s.id))
  .map((s) => ({ id: s.id, label: shortLabels[s.id]?.[lang] ?? s.title[lang] }));
const catLabel = (id: string) => categories.find((c) => c.id === id)?.label ?? '';

// Versión grande (webp) para el lightbox
const fulls = await Promise.all(
  portfolio.map((p) => getImage({ src: p.image, width: 1600, format: 'webp' })),
);
const items = portfolio.map((p, i) => ({ ...p, full: fulls[i].src }));
---

<section class="gallery-section">
  <div class="container">
    <header class="gallery-head">
      <p class="eyebrow">{t('portfolio.eyebrow')}</p>
      <h1 class="gallery-title">{t('portfolio.title')}</h1>
      <p class="gallery-intro">{t('portfolio.intro')}</p>
    </header>

    <div class="gallery-filters" role="tablist" aria-label={t('portfolio.eyebrow')}>
      <button class="gallery-filter is-active" data-filter="all" type="button">{t('portfolio.all')}</button>
      {
        categories.map((c) => (
          <button class="gallery-filter" data-filter={c.id} type="button">
            {c.label}
          </button>
        ))
      }
    </div>

    <ul class="gallery-grid" data-gallery>
      {
        items.map((p, i) => (
          <li
            class:list={['gallery-item', { 'gallery-item--feature': p.feature }]}
            data-category={p.category}
          >
            <button
              class="gallery-item__btn"
              type="button"
              data-full={p.full}
              data-title={`${p.title[lang]} · ${catLabel(p.category)}`}
              aria-label={p.title[lang]}
            >
              <Image
                src={p.image}
                alt={p.title[lang]}
                widths={[300, 600, 900]}
                sizes="(max-width: 50rem) 50vw, 30vw"
                loading={i < 4 ? 'eager' : 'lazy'}
              />
              <span class="gallery-item__cap">
                <span class="gallery-item__name">{p.title[lang]}</span>
                <span class="gallery-item__cat">{catLabel(p.category)}</span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="lightbox" data-lightbox hidden>
    <button class="lightbox__close" type="button" data-lb-close aria-label={t('portfolio.close')}>
      <span aria-hidden="true">&times;</span>
    </button>
    <figure class="lightbox__fig">
      <img class="lightbox__img" data-lb-img alt="" />
      <figcaption class="lightbox__cap" data-lb-cap></figcaption>
    </figure>
  </div>
</section>

<style>
  .gallery-section {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .gallery-head {
    max-width: var(--container-narrow);
    margin-bottom: var(--space-l);
  }
  .gallery-title {
    margin-top: var(--space-2xs);
  }
  .gallery-intro {
    margin-top: var(--space-s);
    color: var(--fg-muted);
  }

  /* --- Filtros --- */
  .gallery-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-xs);
    padding-bottom: var(--space-m);
    margin-bottom: var(--space-l);
    border-bottom: 1px solid var(--rule);
  }
  .gallery-filter {
    padding: 0.5em 1.1em;
    border: 1px solid var(--rule);
    border-radius: 100px;
    background: none;
    color: var(--fg-muted);
    font: inherit;
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    cursor: pointer;
    transition:
      color var(--transition),
      border-color var(--transition),
      background var(--transition);
  }
  .gallery-filter:hover {
    color: var(--fg);
    border-color: var(--fg);
  }
  .gallery-filter.is-active {
    color: #fff;
    border-color: transparent;
    background: var(--gradient-brand);
  }

  /* --- Grid masonry-ish --- */
  .gallery-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-flow: dense;
    gap: var(--space-s);
  }
  @media (min-width: 50rem) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-m);
    }
    .gallery-item--feature {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  .gallery-item {
    overflow: hidden;
    background: var(--bg-alt);
  }
  .gallery-item[hidden] {
    display: none;
  }
  .gallery-item__btn {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .gallery-item__btn :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .gallery-item--feature .gallery-item__btn :global(img) {
    aspect-ratio: 1 / 1;
  }
  .gallery-item__btn:hover :global(img),
  .gallery-item__btn:focus-visible :global(img) {
    transform: scale(1.05);
  }

  .gallery-item__cap {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-s);
    padding: var(--space-s);
    text-align: left;
    color: #fff;
    background: linear-gradient(to top, rgba(13, 13, 14, 0.78), transparent);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity var(--transition),
      transform var(--transition);
  }
  .gallery-item__btn:hover .gallery-item__cap,
  .gallery-item__btn:focus-visible .gallery-item__cap {
    opacity: 1;
    transform: translateY(0);
  }
  .gallery-item__name {
    font-family: var(--font-display);
    font-size: var(--step-0);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .gallery-item__cat {
    font-size: var(--step--1);
    color: var(--brand-orange);
    letter-spacing: 0.04em;
  }

  /* --- Lightbox --- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: var(--gutter);
    background: rgba(13, 13, 14, 0.94);
    opacity: 0;
    transition: opacity var(--transition);
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox.is-open {
    opacity: 1;
  }
  .lightbox__fig {
    margin: 0;
    max-width: min(1100px, 92vw);
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  .lightbox__img {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    margin-inline: auto;
  }
  .lightbox__cap {
    text-align: center;
    color: var(--color-muted-light);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .lightbox__close {
    position: absolute;
    top: var(--space-m);
    right: var(--space-m);
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    font-size: 2rem;
    line-height: 1;
    color: #fff;
    background: none;
    border: 1px solid var(--color-line-dark);
    border-radius: 50%;
    cursor: pointer;
    transition: border-color var(--transition);
  }
  .lightbox__close:hover {
    border-color: var(--brand-orange);
    color: var(--brand-orange);
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('.gallery-section');
  if (section) {
    const filters = section.querySelectorAll<HTMLButtonElement>('.gallery-filter');
    const items = section.querySelectorAll<HTMLLIElement>('.gallery-item');

    filters.forEach((btn) => {
      btn.addEventListener('click', () => {
        filters.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const f = btn.dataset.filter;
        items.forEach((item) => {
          const show = f === 'all' || item.dataset.category === f;
          item.toggleAttribute('hidden', !show);
        });
      });
    });

    // Lightbox
    const lb = section.querySelector<HTMLElement>('[data-lightbox]');
    const lbImg = section.querySelector<HTMLImageElement>('[data-lb-img]');
    const lbCap = section.querySelector<HTMLElement>('[data-lb-cap]');
    const closeBtn = section.querySelector<HTMLButtonElement>('[data-lb-close]');

    const open = (full: string, title: string) => {
      if (!lb || !lbImg || !lbCap) return;
      lbImg.src = full;
      lbImg.alt = title;
      lbCap.textContent = title;
      lb.hidden = false;
      requestAnimationFrame(() => lb.classList.add('is-open'));
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      if (!lb) return;
      lb.classList.remove('is-open');
      document.body.style.overflow = '';
      setTimeout(() => (lb.hidden = true), 280);
    };

    section.querySelectorAll<HTMLButtonElement>('.gallery-item__btn').forEach((btn) => {
      btn.addEventListener('click', () => open(btn.dataset.full ?? '', btn.dataset.title ?? ''));
    });
    closeBtn?.addEventListener('click', close);
    lb?.addEventListener('click', (e) => {
      if (e.target === lb) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lb && !lb.hidden) close();
    });
  }
</script>

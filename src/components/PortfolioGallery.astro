---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useTranslations, defaultLang, type Lang } from '../i18n/ui';
import { ImageGallery, type ImageGalleryItem } from './ui/image-gallery';
import catalogChromaluxeMate from '../assets/catalogo/chromaluxe/mate.webp';
import catalogMagnetos from '../assets/catalogo/aluminios-estandar/impresion-de-magnetos-de-cualquier-tamano.webp';
import catalogImpresionesPata from '../assets/catalogo/opciones-de-montaje-para-exposicion/impresiones-con-pata.webp';
import catalogNumerosMesa from '../assets/catalogo/impresion-de-invitaciones/numeros-para-mesas.webp';
import catalogAluminioAcabados from '../assets/catalogo/aluminios-estandar/aluminios-estandar-en-distintos-acabados.webp';
import catalogAluminioRedondo from '../assets/catalogo/aluminios-estandar/impresiones-redondas-en-aluminio-estandar.webp';
import catalogChromaluxeBoard from '../assets/catalogo/chromaluxe/board-completo-de-aluminio-chromaluxe.webp';
import catalogChromaluxeGloss from '../assets/catalogo/chromaluxe/gloss.webp';
import catalogChromaluxeTextura from '../assets/catalogo/chromaluxe/texturizado.webp';
import catalogAcrilicoBlock from '../assets/catalogo/impresiones-en-acrilico/impresion-acrilica-de-4-mm-de-espesor-10x10-pulgadas.webp';
import catalogAcrilicoRedondo from '../assets/catalogo/impresiones-en-acrilico/impresion-en-acriloico-redonda-para-bajaplatos.webp';
import catalogInvitaciones from '../assets/catalogo/impresion-de-invitaciones/invitaciones-empresariales.webp';
import catalogMontaje from '../assets/catalogo/opciones-de-montaje-para-exposicion/montaje-con-separadores-de-vidrio.webp';
import catalogPortavasos from '../assets/catalogo/portavasos/portavasos-01.webp';
import catalogSenalizacion from '../assets/catalogo/senalizacion/ambientacion-de-oficinas.webp';
import catalogTagMaleta from '../assets/catalogo/varios/tag-de-maleta-cuadrado-3-5x3-5.webp';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

interface GallerySource {
  image: ImageMetadata;
  alt: Record<Lang, string>;
}

const catalogSources: GallerySource[] = [
  {
    image: catalogAluminioAcabados,
    alt: {
      es: 'Aluminios estándar en distintos acabados',
      en: 'Standard aluminum in multiple finishes',
    },
  },
  {
    image: catalogAluminioRedondo,
    alt: {
      es: 'Impresiones redondas en aluminio estándar',
      en: 'Round prints on standard aluminum',
    },
  },
  {
    image: catalogChromaluxeBoard,
    alt: {
      es: 'Board completo de aluminio ChromaLuxe',
      en: 'Complete ChromaLuxe aluminum board',
    },
  },
  {
    image: catalogChromaluxeGloss,
    alt: {
      es: 'Aluminio ChromaLuxe con acabado gloss',
      en: 'ChromaLuxe aluminum with gloss finish',
    },
  },
  {
    image: catalogChromaluxeTextura,
    alt: {
      es: 'Aluminio ChromaLuxe con acabado texturizado',
      en: 'ChromaLuxe aluminum with textured finish',
    },
  },
  {
    image: catalogAcrilicoBlock,
    alt: {
      es: 'Impresión acrílica de 4 mm de espesor',
      en: '4 mm thick acrylic print',
    },
  },
  {
    image: catalogAcrilicoRedondo,
    alt: {
      es: 'Impresión en acrílico redonda para bajaplatos',
      en: 'Round acrylic print for charger plates',
    },
  },
  {
    image: catalogInvitaciones,
    alt: {
      es: 'Invitaciones empresariales impresas',
      en: 'Printed corporate invitations',
    },
  },
  {
    image: catalogMontaje,
    alt: {
      es: 'Montaje con separadores de vidrio',
      en: 'Glass standoff mounting',
    },
  },
  {
    image: catalogPortavasos,
    alt: {
      es: 'Portavasos personalizados impresos por Artek',
      en: 'Custom coasters printed by Artek',
    },
  },
  {
    image: catalogSenalizacion,
    alt: {
      es: 'Ambientación de oficinas con señalización impresa',
      en: 'Office ambiance with printed signage',
    },
  },
  {
    image: catalogTagMaleta,
    alt: {
      es: 'Tag de maleta cuadrado personalizable',
      en: 'Custom square luggage tag',
    },
  },
];

const portfolioSources: GallerySource[] = [
  {
    image: catalogChromaluxeMate,
    alt: { es: 'Aluminio ChromaLuxe con acabado mate', en: 'ChromaLuxe aluminum with matte finish' },
  },
  {
    image: catalogMagnetos,
    alt: { es: 'Impresión de magnetos de cualquier tamaño', en: 'Magnet printing in custom sizes' },
  },
  {
    image: catalogImpresionesPata,
    alt: { es: 'Impresiones en aluminio con pata', en: 'Aluminum prints with easel stand' },
  },
  {
    image: catalogNumerosMesa,
    alt: { es: 'Números de mesa impresos', en: 'Printed table numbers' },
  },
];

const galleryImages: ImageGalleryItem[] = await Promise.all(
  [...portfolioSources, ...catalogSources].map(async ({ image, alt }) => {
    const optimized = await getImage({
      src: image,
      width: Math.min(image.width, 1600),
      format: 'webp',
    });

    return {
      src: optimized.src,
      alt: alt[lang],
      width: image.width,
      height: image.height,
    };
  }),
);
---

<section class="gallery-section">
  <div class="container">
    <header class="gallery-head" data-reveal>
      <span class="gallery-head__mark" aria-hidden="true"></span>
      <h1 class="gallery-title">{t('portfolio.title')}</h1>
      <p class="gallery-intro">{t('portfolio.intro')}</p>
    </header>

    <div class="gallery-island" data-reveal>
      <ImageGallery images={galleryImages} client:visible />
    </div>
  </div>

  <div class="lightbox" data-lightbox hidden>
    <button class="lightbox__close" type="button" data-lb-close aria-label={t('portfolio.close')}>
      <span aria-hidden="true">&times;</span>
    </button>
    <figure class="lightbox__fig">
      <img class="lightbox__img" data-lb-img alt="" />
      <figcaption class="lightbox__cap" data-lb-cap></figcaption>
    </figure>
  </div>
</section>

<style>
  .gallery-section {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .gallery-head {
    max-width: var(--container-narrow);
    margin-bottom: var(--space-l);
  }
  .gallery-head__mark {
    display: block;
    width: 3rem;
    height: 3px;
    border-radius: 2px;
    background: var(--gradient-brand);
    margin-bottom: var(--space-m);
  }
  .gallery-intro {
    margin-top: var(--space-s);
    color: var(--fg-muted);
  }

  .gallery-island {
    border-top: 1px solid var(--rule);
  }
  .gallery-island :global(astro-island) {
    display: block;
  }
  .gallery-island :global(.portfolio-island__item) {
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.025)),
      var(--bg-alt);
    box-shadow: 0 20px 44px rgba(0, 0, 0, 0.24);
  }
  .gallery-island :global(.portfolio-island__button) {
    display: block;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }
  .gallery-island :global(.portfolio-island__image) {
    filter: brightness(0.9) saturate(0.98);
    transition:
      opacity 1000ms ease-in-out,
      transform var(--dur-image) var(--ease-art),
      filter var(--dur) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .gallery-island :global(.portfolio-island__button:hover .portfolio-island__image) {
      transform: scale(1.045);
      filter: brightness(1.04) saturate(1.05);
    }
  }
  .gallery-island :global(.portfolio-island__button:focus-visible .portfolio-island__image) {
    transform: scale(1.045);
    filter: brightness(1.04) saturate(1.05);
  }

  /* --- Lightbox --- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: var(--gutter);
    background: color-mix(in srgb, var(--color-void) 96%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox.is-open {
    opacity: 1;
  }
  .lightbox__fig {
    transform: scale(0.96);
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .lightbox.is-open .lightbox__fig {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox__fig {
      transform: none;
    }
  }
  .lightbox__fig {
    margin: 0;
    max-width: min(1100px, 92vw);
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  .lightbox__img {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    margin-inline: auto;
  }
  .lightbox__cap {
    text-align: center;
    color: var(--color-muted-light);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .lightbox__close {
    position: absolute;
    top: var(--space-m);
    right: var(--space-m);
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    font-size: 2rem;
    line-height: 1;
    color: #fff;
    background: none;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    cursor: pointer;
    transition:
      border-color var(--transition),
      color var(--transition);
  }
  .lightbox__close:hover {
    border-color: var(--brand-orange);
    color: var(--brand-orange);
  }
</style>

<script>
  type GalleryOpenDetail = {
    src?: string;
    alt?: string;
    title?: string;
  };

  let cleanupGalleryLightbox: (() => void) | undefined;

  function initGalleryLightbox() {
    cleanupGalleryLightbox?.();

    const section = document.querySelector<HTMLElement>('.gallery-section');
    if (!section) return;

    const controller = new AbortController();
    cleanupGalleryLightbox = () => controller.abort();

    const lb = section.querySelector<HTMLElement>('[data-lightbox]');
    const lbImg = section.querySelector<HTMLImageElement>('[data-lb-img]');
    const lbCap = section.querySelector<HTMLElement>('[data-lb-cap]');
    const closeBtn = section.querySelector<HTMLButtonElement>('[data-lb-close]');
    let lastTrigger: HTMLElement | null = null;

    const open = (detail: GalleryOpenDetail) => {
      if (!lb || !lbImg || !lbCap || !detail.src) return;

      lastTrigger = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      const title = detail.title ?? detail.alt ?? '';
      lbImg.src = detail.src;
      lbImg.alt = detail.alt ?? title;
      lbCap.textContent = title;
      lb.hidden = false;
      requestAnimationFrame(() => lb.classList.add('is-open'));
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    };

    const close = () => {
      if (!lb) return;
      lb.classList.remove('is-open');
      document.body.style.overflow = '';
      setTimeout(() => (lb.hidden = true), 420);
      lastTrigger?.focus();
    };

    window.addEventListener(
      'artek:gallery-open',
      (event) => open((event as CustomEvent<GalleryOpenDetail>).detail ?? {}),
      { signal: controller.signal },
    );
    closeBtn?.addEventListener('click', close, { signal: controller.signal });
    lb?.addEventListener(
      'click',
      (event) => {
        if (event.target === lb) close();
      },
      { signal: controller.signal },
    );
    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && lb && !lb.hidden) close();
      },
      { signal: controller.signal },
    );
    document.addEventListener('astro:before-swap', () => cleanupGalleryLightbox?.(), {
      once: true,
      signal: controller.signal,
    });
  }

  document.addEventListener('astro:page-load', initGalleryLightbox);
</script>

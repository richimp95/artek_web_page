---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';
import { CardCarousel } from './ui/card-carousel';
import aluminioAcabados from '../assets/catalogo/aluminios-estandar/aluminio-estandar-plateado-dorado-y-color-cobre.webp';
import aluminioOctogonal from '../assets/catalogo/aluminios-estandar/impresiones-octogonales.webp';
import chromaluxeBoard from '../assets/catalogo/chromaluxe/board-completo-de-aluminio-chromaluxe.webp';
import chromaluxeTexturizado from '../assets/catalogo/chromaluxe/texturizado.webp';
import acrilicoBlock from '../assets/catalogo/impresiones-en-acrilico/impresion-acrilica-de-4-mm-de-espesor-10x10-pulgadas.webp';
import acrilicoRedondo from '../assets/catalogo/impresiones-en-acrilico/impresion-acrilica-redonda-para-reconocimientos.webp';
import invitacionesAluminio from '../assets/catalogo/impresion-de-invitaciones/invitaciones-impresas-en-aluminio-de-cualquier-tamano.webp';
import menusAluminio from '../assets/catalogo/impresion-de-invitaciones/menus.webp';
import montajeSeparadores from '../assets/catalogo/opciones-de-montaje-para-exposicion/montaje-con-separadores-de-vidrio.webp';
import montajePata from '../assets/catalogo/opciones-de-montaje-para-exposicion/impresion-en-aluminio-gloss-chromaluxe-con-pata.webp';
import portavasos from '../assets/catalogo/portavasos/portavasos-01.webp';
import senalizacion from '../assets/catalogo/senalizacion/ambientacion-de-oficinas.webp';
import {
  useTranslations,
  getRoutePath,
  whatsappHref,
  defaultLang,
  type Lang,
} from '../i18n/ui';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
const portfolioHref = getRoutePath(lang, 'portfolio');
const carouselSources: { image: ImageMetadata; alt: Record<Lang, string> }[] = [
  {
    image: aluminioAcabados,
    alt: {
      es: 'Aluminio estándar plateado, dorado y color cobre impreso por Artek',
      en: 'Standard silver, gold and copper aluminum printed by Artek',
    },
  },
  {
    image: aluminioOctogonal,
    alt: {
      es: 'Impresiones octogonales en aluminio estándar',
      en: 'Octagonal prints on standard aluminum',
    },
  },
  {
    image: chromaluxeBoard,
    alt: {
      es: 'Board completo de aluminio ChromaLuxe con acabados premium',
      en: 'Complete ChromaLuxe aluminum board with premium finishes',
    },
  },
  {
    image: chromaluxeTexturizado,
    alt: {
      es: 'Impresión sobre aluminio ChromaLuxe texturizado',
      en: 'Print on textured ChromaLuxe aluminum',
    },
  },
  {
    image: acrilicoBlock,
    alt: {
      es: 'Impresión acrílica de 4 mm de espesor en formato 10 por 10 pulgadas',
      en: '4 mm acrylic print in 10 by 10 inch format',
    },
  },
  {
    image: acrilicoRedondo,
    alt: {
      es: 'Impresión acrílica redonda para reconocimientos',
      en: 'Round acrylic print for awards',
    },
  },
  {
    image: invitacionesAluminio,
    alt: {
      es: 'Invitaciones impresas en aluminio de cualquier tamaño',
      en: 'Invitations printed on aluminum in custom sizes',
    },
  },
  {
    image: menusAluminio,
    alt: {
      es: 'Menús impresos en aluminio para eventos',
      en: 'Menus printed on aluminum for events',
    },
  },
  {
    image: montajeSeparadores,
    alt: {
      es: 'Montaje con separadores de vidrio para exposición',
      en: 'Glass standoff mounting for display',
    },
  },
  {
    image: montajePata,
    alt: {
      es: 'Impresión en aluminio gloss ChromaLuxe con pata de soporte',
      en: 'Gloss ChromaLuxe aluminum print with easel stand',
    },
  },
  {
    image: portavasos,
    alt: {
      es: 'Portavasos personalizados impresos por Artek',
      en: 'Custom coasters printed by Artek',
    },
  },
  {
    image: senalizacion,
    alt: {
      es: 'Ambientación de oficinas con señalización impresa',
      en: 'Office ambiance with printed signage',
    },
  },
];
const carouselImages = await Promise.all(
  carouselSources.map(async ({ image, alt }) => {
    const optimized = await getImage({
      src: image,
      width: 640,
      format: 'webp',
    });

    return {
      src: optimized.src,
      alt: alt[lang],
    };
  }),
);
---

<section class="hero">
  <div class="hero__text">
    <p class="eyebrow">{t('hero.eyebrow')}</p>
    <h1 class="hero__headline">{t('hero.headline')}</h1>
    <p class="hero__lead">{t('hero.lead')}</p>
    <div class="hero__actions">
      <Button href={whatsappHref(lang)} variant="solid" external>{t('hero.cta_primary')}</Button>
      <Button href={portfolioHref} variant="ghost">{t('hero.cta_secondary')}</Button>
    </div>
  </div>

  <div class="hero__media">
    <CardCarousel
      images={carouselImages}
      autoplayDelay={2800}
      showPagination
      showNavigation={false}
      client:visible
    />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-l);
    align-items: center;
    padding-block: var(--space-xl);
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    padding-inline: var(--gutter);
    max-width: var(--container);
    margin-inline: auto;
    width: 100%;
  }

  .hero__headline {
    max-width: 14ch;
  }

  .hero__lead {
    font-size: var(--step-1);
    color: var(--fg-muted);
    max-width: 44ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin-top: var(--space-s);
  }

  .hero__media {
    overflow: hidden;
    padding-inline: var(--gutter);
    width: 100%;
  }
  .hero__media :global(astro-island) {
    display: block;
    width: 100%;
  }

  /* Entrada al cargar (Emil: nunca desde scale(0); ease-out; escalonado). */
  .hero__text > * {
    animation: hero-rise 700ms var(--ease-out) backwards;
  }
  .hero__text > :nth-child(1) { animation-delay: 80ms; }
  .hero__text > :nth-child(2) { animation-delay: 160ms; }
  .hero__text > :nth-child(3) { animation-delay: 240ms; }
  .hero__text > :nth-child(4) { animation-delay: 320ms; }
  .hero__media {
    animation: hero-reveal 900ms var(--ease-art) 120ms backwards;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  @keyframes hero-reveal {
    from {
      opacity: 0;
      clip-path: inset(0 0 0 12%);
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__text > *,
    .hero__media {
      animation: none;
    }
  }

  /* Layout asimétrico editorial en pantallas grandes */
  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: 1fr 1fr;
      gap: 0;
      padding-block: 0;
      min-height: min(80vh, 720px);
    }
    .hero__text {
      padding-block: var(--space-2xl);
    }
    .hero__media {
      height: 100%;
      display: flex;
      align-items: center;
      padding: var(--space-l) var(--gutter) var(--space-l) 0;
    }
  }

  @media (min-width: 90rem) {
    /* La imagen sangra hasta el borde derecho de la ventana */
    .hero {
      grid-template-columns: 1fr minmax(0, 50vw);
    }
  }
</style>

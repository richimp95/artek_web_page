---
import Button from './Button.astro';
import { useTranslations, whatsappHref, defaultLang, type Lang } from '../i18n/ui';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
---

<section class="wip-hero">
  <div class="container wip-hero__inner">
    <p class="eyebrow">{t('wip.kicker')}</p>
    <h1 class="wip-hero__title">{t('wip.title')}</h1>
    <p class="wip-hero__body">{t('wip.body')}</p>
    <div class="wip-hero__actions">
      <Button href={whatsappHref(lang)} variant="solid" external>
        {t('wip.contact')}
        <span aria-hidden="true">&rarr;</span>
      </Button>
    </div>
  </div>
</section>

<style>
  .wip-hero {
    padding-block: clamp(var(--space-xl), 12vw, var(--space-2xl));
  }
  .wip-hero__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
  .wip-hero__title {
    max-width: 16ch;
  }
  .wip-hero__body {
    font-size: var(--step-1);
    color: var(--fg-muted);
    max-width: 46ch;
  }
  .wip-hero__actions {
    margin-top: var(--space-s);
  }
</style>
